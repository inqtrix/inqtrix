{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.browser-tests.tsbuildinfo",
    "types": ["node", "vite/client"],
    /* collaboration-server sources are imported as they are; its own config checks them. */
    "erasableSyntaxOnly": false,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["browser-tests"]
}
