# ============================================================
# Inqtrix starter environment template
# ============================================================
#
# Copy this file to .env for local development and keep .env untracked.
# Fill in only the sections that match the runtime path you actually use.
#
# This template focuses on provider, auth, endpoint, and model variables
# for the default env mode and for examples/provider_stacks/ and
# examples/custom_providers/, plus server runtime (section 6),
# logging/observability (section 7), and authentication (section 8).
#
# Single source of truth for EVERY variable (every alias, default, and allowed
# value, including groups this template does not cover -- queue/worker, quota,
# knowledge tuning, server hardening): docs/configuration/settings-and-env.md
# (backed by src/inqtrix/settings.py). This file is a curated starter, not the
# full reference.

# ============================================================
# 1. Default env-based runtime
# ============================================================
#
# Used when you call ResearchAgent() without injecting explicit providers,
# or when the server runs in env-only mode.
#
# In this path, settings.py + providers/__init__.py auto-create:
# - LiteLLM for reasoning, classify, summarize, and evaluate
# - PerplexitySearch for web search
#
# Both providers share the same LiteLLM or OpenAI-compatible endpoint and
# the same key. Search therefore uses LITELLM_BASE_URL + LITELLM_API_KEY
# here, not a direct PERPLEXITY_API_KEY.

# Shared LiteLLM or OpenAI-compatible proxy endpoint.
# Example 1 uses http://localhost:4000/v1.
LITELLM_BASE_URL=http://localhost:4000/v1

# Shared key for BOTH LiteLLM reasoning calls and PerplexitySearch when the
# default env mode routes everything through the same proxy.
LITELLM_API_KEY=sk-your-litellm-key

# Optional model overrides.
#
# All variables in this block are optional because ModelSettings in
# src/inqtrix/settings.py already defines defaults:
# - REASONING_MODEL defaults to claude-opus-4.6-agent
# - SEARCH_MODEL defaults to perplexity-sonar-pro-agent
# - CLASSIFY_MODEL, CLAIM_EXTRACT_MODEL, and EVALUATE_MODEL default to empty
#   and then fall back to REASONING_MODEL at runtime
#
# Leave this whole block commented out if you want the built-in model mix.
# Define one or more of these vars only if you want to serve Inqtrix with a
# different setup, for example when:
# - your LiteLLM or OpenAI-compatible proxy exposes different model aliases
# - you want cheaper classify, summarize, or evaluate roles in server mode
# - you map roles to separate Azure or LiteLLM deployments
# - you want to benchmark or A/B test a different reasoning/search stack

# Main reasoning model used for planning, synthesis, and as the fallback
# for unset role-specific overrides.
# REASONING_MODEL=claude-opus-4.6-agent

# Search model used by PerplexitySearch in env mode.
# REASONING_MODEL and SEARCH_MODEL are independent on purpose.
# SEARCH_MODEL=perplexity-sonar-pro-agent

# Optional per-role override for question classification.
# Unset or empty means: use REASONING_MODEL.
# CLASSIFY_MODEL=your-classify-model

# Optional per-role override for claim extraction (the highest-volume role:
# one call per search hit, so the largest cost lever).
# Unset or empty means: use REASONING_MODEL.
# CLAIM_EXTRACT_MODEL=your-claim-extract-model

# Optional per-role override for evidence evaluation.
# Unset or empty means: use REASONING_MODEL.
# EVALUATE_MODEL=your-evaluate-model

# --- Server-mode provider selector (mix-and-match) ---
#
# When the HTTP server auto-builds providers, two INDEPENDENT axes choose the
# stack (4 x 2 combinations; any LLM pairs with any search backend). Unset means
# litellm + perplexity, i.e. the byte-identical legacy default above. An unknown
# value fails loudly at startup (no silent fallback). Put the matching
# credentials in sections 2-4 below; see
# docs/getting-started/provider-recipes.md for a per-combination recipe.
# INQTRIX_LLM_PROVIDER     in {litellm, anthropic, azure, bedrock}  (default litellm)
# INQTRIX_SEARCH_PROVIDER  in {perplexity, azure_foundry}           (default perplexity)
#INQTRIX_LLM_PROVIDER=litellm
#INQTRIX_SEARCH_PROVIDER=perplexity

# --- Model completeness (every model knob the Python stack exposes) ---
#
# Comma-separated chat models offered in the UI model picker. Feeds
# /health.models_catalog. Empty means only the resolved default model is offered.
#INQTRIX_SELECTABLE_CHAT_MODELS=claude-opus-4-8,claude-sonnet-4-6

# Optional sampling temperature for the Anthropic/Azure/Bedrock providers.
# LiteLLM ignores it and logs a visible warning when set (no silent drop).
#INQTRIX_TEMPERATURE=0.2

# Output-budget request field for the LiteLLM/Azure providers: max_tokens or
# max_completion_tokens (the latter required by OpenAI o-series). Empty uses each
# provider's own default. Anthropic/Bedrock ignore it (logged when set).
#INQTRIX_TOKEN_BUDGET_PARAMETER=max_tokens

# Web search has ONE model (SEARCH_MODEL above) plus a preset and free-text
# instructions -- there are no high/mid/fast tiers like the LLM has.
# Preset: fast-search (default) | pro-search | deep-research. Both are ignored
# by the azure_foundry search backend (logged when set).
#INQTRIX_SEARCH_PRESET=pro-search
#INQTRIX_SEARCH_INSTRUCTIONS=

# Per-tier reasoning effort for the research pipeline. Empty inherits the
# provider default (no implicit reasoning). One of:
# none | minimal | low | medium | high | xhigh. For Anthropic any non-empty,
# non-"none" value turns on adaptive thinking. The context window and output
# budget are NOT env vars -- the model cards (src/inqtrix/model_cards.py) are
# the authoritative source.
#TIER_HIGH_EFFORT=high
#TIER_MID_EFFORT=medium
#TIER_FAST_EFFORT=low

# ============================================================
# 2. Direct provider credentials for explicit examples
# ============================================================
#
# These vars are for the explicit-provider scripts, not for the env-only
# auto-create path above.
#
# Provider stack examples (same folder has LiteLLM and Azure web search/Foundry):
# - examples/provider_stacks/anthropic_perplexity.py
# - examples/provider_stacks/bedrock_perplexity.py
# - examples/provider_stacks/azure_openai_perplexity.py

# Direct Anthropic API key for AnthropicLLM.
# Anthropic is an LLM provider only. Search still needs a separate provider.
ANTHROPIC_API_KEY=

# Direct Perplexity Sonar API key for examples that call Perplexity without a
# LiteLLM proxy. Keep this defined only once.
PERPLEXITY_API_KEY=

# Optional AWS named profile for Bedrock example 3.
# Leave empty to use the default AWS credential chain/profile.
AWS_PROFILE=

# Optional AWS region for Bedrock example 3.
# The example defaults to eu-central-1 if this is empty.
AWS_REGION=eu-central-1

# ============================================================
# 3. Azure OpenAI reasoning provider
# ============================================================
#
# Used by the Azure examples for reasoning/model calls via AzureOpenAILLM.
#
# Important caveats:
# - AZURE_OPENAI_ENDPOINT must be the Azure OpenAI resource root.
# - Do NOT add /openai/v1 here; the provider appends /openai/v1 internally.
# - AZURE_OPENAI_DEPLOYMENT_NAME must be the deployment name, not the base
#   model name such as gpt-4o.

# Azure OpenAI API key for the default API-key auth path in the Azure examples.
AZURE_OPENAI_API_KEY=

# Azure OpenAI resource root, for example:
# https://your-resource.openai.azure.com/
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/

# Azure deployment name used by AzureOpenAILLM (read by the azure example
# scripts). This must be the deployment name configured in Azure.
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name

# Optional Entra ID / service principal auth values used by the commented
# Azure example paths instead of API-key auth.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ============================================================
# 4. Azure AI Foundry Web Search provider
# ============================================================
#
# Project-scoped endpoint used by the Foundry Web Search path below.
# It should look like:
# https://your-project.services.ai.azure.com/api/projects/your-project
AZURE_AI_PROJECT_ENDPOINT=https://YOUR_PROJECT.services.ai.azure.com/api/projects/YOUR_PROJECT

# ------------------------------------------------------------
# Foundry Web Search path
# ------------------------------------------------------------
#
# Used by:
# - examples/provider_stacks/azure_foundry_web_search.py
# - examples/provider_stacks/azure_smoke_tests/test_foundry_web_search.py
#
# This path uses the project-scoped Responses API with agent_reference.
# WEB_SEARCH_AGENT_NAME identifies the existing Web Search agent by name.
# WEB_SEARCH_AGENT_VERSION is optional; leave empty for the default/latest.

# Existing Web Search agent name for the Foundry Responses API path.
WEB_SEARCH_AGENT_NAME=

# Optional pinned agent version. Leave empty for the default/latest version.
WEB_SEARCH_AGENT_VERSION=

# Optional project API key for the Foundry Web Search path only.
# This is used by AzureFoundryWebSearch when you choose API-key auth.
AZURE_AI_PROJECT_API_KEY=

# ============================================================
# 5. Everything else (queue/worker, quota, knowledge, server hardening)
# ============================================================
#
# This template covers the common provider/auth/endpoint/model path. The
# remaining variable groups are documented with defaults and allowed values
# in the single source of truth, docs/configuration/settings-and-env.md:
# - Run queue + workers: INQTRIX_QUEUE_BACKEND, INQTRIX_VALKEY_URL,
#   INQTRIX_WORKER_CONCURRENCY / _MAX_ATTEMPTS / _HEARTBEAT_SECONDS / _CLAIM_IDLE_SECONDS
# - Per-user quotas: INQTRIX_QUOTA_* (oidc multi-user; default off)
# - Knowledge/embedding/rerank/reindex tuning: INQTRIX_KNOWLEDGE_* /
#   INQTRIX_EMBEDDING_* / INQTRIX_RERANKER_* / INQTRIX_REINDEX_* /
#   INQTRIX_GENERATION_* (sections 11+)
# - Server hardening: INQTRIX_SERVER_CORS_ORIGINS, INQTRIX_ENABLE_OPENAPI,
#   INQTRIX_SERVER_TLS_KEYFILE / _CERTFILE, INQTRIX_MAX_TOTAL_INPUT_TOKENS,
#   INQTRIX_MAX_MESSAGE_COUNT
# Inqtrix has no YAML config layer; everything is env-driven (or constructor
# args in library mode).


# ============================================================
# 6. HTTP server runtime limits
# ============================================================
#
# Used by python -m inqtrix and examples/webserver_stacks/*.py.
# The OpenAI-compatible /v1/chat/completions path returns HTTP 429 when
# MAX_CONCURRENT is saturated. The native /v1/runs path can use a separate
# RUN_MAX_CONCURRENT active-worker cap plus a bounded in-memory FIFO queue.

# Maximum active /v1/chat/completions requests in this process. Native
# /v1/runs workers use RUN_MAX_CONCURRENT, which has its own default of 100.
# Commenting that line out yields 100, not a fallback to this value, and an
# empty value fails startup validation.
#MAX_CONCURRENT=100

# Optional maximum active native /v1/runs workers in this process.
#RUN_MAX_CONCURRENT=100

# Maximum native /v1/runs jobs waiting in the FIFO queue. Active jobs do
# not count against this limit.
#RUN_QUEUE_MAX_SIZE=100

# How long completed/failed/cancelled native run records and buffered events
# stay queryable in memory. Use a database later for durable completed reports.
#RUN_COMPLETED_TTL_SECONDS=300

# How long a finished incognito Knowledge Desk ask stays in either run store
# before the run, its events and its result are deleted (at least 60).
#RUN_INCOGNITO_RETENTION_SECONDS=900

# Per-run structured event replay buffer for late SSE subscribers.
#RUN_EVENT_BUFFER_SIZE=200

# --- Agent timeouts (seconds) ---
# These bound how long the agent and the editor/text endpoints may run. Every
# per-call timeout below is ALSO clamped to the time still left against
# MAX_TOTAL_SECONDS, so no single call can outlive the whole run. The DEEP
# report profile (REPORT_PROFILE=deep) raises all of them; the values shown are
# the COMPACT defaults. See docs/configuration/settings-and-env.md
# ("Timeout dependency chain") for which HTTP wait derives from which budget.

# Wall-clock deadline for an entire research run, checked at node boundaries.
# Also the base for the chat and SSE HTTP wait (this value + 30s). DEEP: 1800.
#MAX_TOTAL_SECONDS=300

# Per-call timeout for reasoning LLM calls (classify, plan, evaluate, answer).
# DEEP: 900.
#REASONING_TIMEOUT=120

# Per-call timeout for editor suggest/instruct calls, decoupled from
# REASONING_TIMEOUT. Raise this if long editor instructions with large
# attachments hit a 504, without lengthening research reasoning calls.
# DEEP: 900.
#EDITOR_ASSISTANT_TIMEOUT=120

# Per-call timeout for search-provider calls. Keep below
# MAX_TOTAL_SECONDS / FIRST_ROUND_QUERIES so one slow query cannot consume the
# whole run budget. DEEP: 300.
#SEARCH_TIMEOUT=60

# Per-call timeout for claim-extraction LLM calls (one per search hit) and for
# the /v1/text improvement call. Tight by design. DEEP: 600.
#CLAIM_EXTRACT_TIMEOUT=60


# ============================================================
# 7. Logging, observability, and testing exports
# ============================================================
#
# Example scripts and python -m inqtrix read INQTRIX_LOG_* via configure_logging.
# AgentSettings (env mode and server) loads OBSERVABILITY_PROFILE and TESTING_MODE.
# URL query secrets are redacted in log output; do not paste live API keys into tickets.
#
# File logging (library, examples, and server all use the same convention).
# Leave INQTRIX_LOG_ENABLED unset/false for a quiet default run. Set it to
# true when you want a persistent logs/inqtrix_<timestamp>.log file.
#
# INQTRIX_LOG_ENABLED=true   — create the file log
# INQTRIX_LOG_LEVEL=INFO     — lifecycle, warnings, fallback visibility
# INQTRIX_LOG_LEVEL=DEBUG    — content-minimized per-round trace + EVENT lines
# INQTRIX_LOG_CONSOLE=true   — additionally mirror WARNING+ to stderr
#
# When file logging is on, the HTTP server examples can also mirror uvicorn
# and FastAPI into the same file (see examples/webserver_stacks/README.md):
# INQTRIX_LOG_INCLUDE_WEB=true   — default; set false to skip uvicorn mirror
# INQTRIX_LOG_WEB_LEVEL=INFO      — level for uvicorn/fastapi loggers in that mirror
#
# Structured lineage has two switches:
# - OBSERVABILITY_PROFILE controls whether detailed forensic events are produced.
# - INQTRIX_LOG_LEVEL controls whether those DEBUG-level EVENT lines are visible
#   in the file log.
#
# OBSERVABILITY_PROFILE=summary    — default; normal iteration summaries only
# OBSERVABILITY_PROFILE=debug      — currently reserved for future mid-level detail
# OBSERVABILITY_PROFILE=forensic   — full lineage in protected run audit;
#                                     ordinary logs receive IDs/states/metrics only
#
# Therefore, forensic file logs need all three:
#   INQTRIX_LOG_ENABLED=true
#   INQTRIX_LOG_LEVEL=DEBUG
#   OBSERVABILITY_PROFILE=forensic
# Operator recipes: docs/observability/forensic-cookbook.md
#
# TESTING_MODE is separate from the file log. When true, iteration summaries
# and forensic events (if OBSERVABILITY_PROFILE=forensic) are also attached to
# ResearchResult metrics / HTTP POST /v1/test/run responses as iteration_logs.
# Never enable TESTING_MODE in production.
# TESTING_MODE=true   — default false; see docs/observability/iteration-log.md
#
# Common recipes:
#
# 1) Quiet default:
#    leave all logging variables commented out
#
# 2) Persistent summary log:
#INQTRIX_LOG_ENABLED=true
#INQTRIX_LOG_LEVEL=INFO
#
# 3) Algorithm debug log (per-round trace, no detailed lineage):
#INQTRIX_LOG_ENABLED=true
#INQTRIX_LOG_LEVEL=DEBUG
#
# 4) Content-minimized forensic file log (lineage IDs/states/metrics):
#INQTRIX_LOG_ENABLED=true
#INQTRIX_LOG_LEVEL=DEBUG
#INQTRIX_LOG_CONSOLE=false
#INQTRIX_LOG_INCLUDE_WEB=true
#INQTRIX_LOG_WEB_LEVEL=INFO
#OBSERVABILITY_PROFILE=forensic
#
# 5) Export iteration_logs for parity/testing tools:
#TESTING_MODE=true


# ============================================================
# 8. Authentication (none | apikey | oidc | local)
# ============================================================
#
# Default is `none` (one anonymous principal, no login). For per-user
# email/password accounts use `local`; for browser SSO use `oidc`.
# Background and per-mode walkthroughs:
# docs/deployment/auth-modes.md and docs/deployment/create-and-manage-users.md.

# none: single anonymous principal. Leave AUTH_MODE unset, or set explicitly:
#INQTRIX_AUTH_MODE=none

# apikey: one shared Bearer-token gate (no per-user identity).
#INQTRIX_AUTH_MODE=apikey
#INQTRIX_SERVER_API_KEY=CHANGE_ME_SHARED_BEARER_TOKEN

# The cookie-session modes (local, oidc) all require these two secrets
# (>= 32 chars; generate one per deployment, share across replicas, keep out
# of version control):
#INQTRIX_SESSION_SECRET=CHANGE_ME_SESSION_SECRET
#INQTRIX_PAT_PEPPER=CHANGE_ME_PAT_PEPPER
# Stable subject pseudonyms in logs/audit correlation: share ONE value across
# API server and workers so the same person keeps the same usr_<hex>
# reference over processes and restarts. Empty = per-process references
# (startup WARNING). Required for oidc; rotation unlinks old pseudonyms.
#INQTRIX_PSEUDONYM_PEPPER=CHANGE_ME_PSEUDONYM_PEPPER
# Plain-HTTP localhost dev ONLY -- drops the Secure/__Host- cookie flags so a
# browser keeps the session over http. Never enable behind real TLS / in prod.
#INQTRIX_OIDC_INSECURE_DEV_COOKIES=false

# local: native email/password with a first-run owner setup (needs PostgreSQL,
# section 9). Passwords are argon2id hashes, never stored or logged in plain.
#INQTRIX_AUTH_MODE=local
# Account policy: closed (default; owner via setup, further accounts admin-
# created/invited) or open (public self-signup route, logged loudly).
#INQTRIX_LOCAL_REGISTRATION=closed


# oidc: browser SSO via your IdP (Dex, Keycloak, Okta, ...).
#INQTRIX_AUTH_MODE=oidc
#INQTRIX_PUBLIC_BASE_URL=https://research.example.com
#INQTRIX_OIDC_ISSUER=https://your-idp.example/
#INQTRIX_OIDC_CLIENT_ID=inqtrix
#INQTRIX_OIDC_CLIENT_SECRET=CHANGE_ME_OIDC_CLIENT_SECRET

# Login brute-force throttling for the password mode (local). On by
# default; keyed per identifier + client IP (sliding window plus lockout).
#INQTRIX_LOGIN_RATE_LIMIT_ENABLED=true
#INQTRIX_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
#INQTRIX_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
#INQTRIX_LOGIN_RATE_LIMIT_LOCKOUT_SECONDS=60


# ============================================================
# 9. Platform persistence (PostgreSQL, optional)
# ============================================================
#
# The identity layer (workspaces, memberships, shares, audit log)
# defaults to in-process memory: no external services, nothing to
# configure. Switch to PostgreSQL for persistent multi-user identity
# facts; start the local stack first (see
# docs/development/local-infrastructure.md) and apply the schema with
# `uv run inqtrix-migrate`.

# Backend selector: memory (default, no infra) | postgres.
#INQTRIX_STORAGE_BACKEND=postgres

# SQLAlchemy async URL; required when the backend is postgres.
#INQTRIX_DATABASE_URL=postgresql+asyncpg://inqtrix:inqtrix-dev-password@127.0.0.1:5432/inqtrix

# Restricted role every application transaction switches to via
# SET LOCAL ROLE so row-level security applies even for owner or
# superuser connections. Created by the migrations; change only if
# your operations team manages roles differently.
#INQTRIX_DATABASE_APP_ROLE=inqtrix_app


# ============================================================
# 10. File storage (object store, optional)
# ============================================================
#
# Uploaded files: metadata lives in the storage backend (memory or
# postgres, section 9), the bytes live in an object store. Default is
# a local directory — zero configuration. For the S3-compatible dev
# stack (SeaweedFS) see docs/development/local-infrastructure.md.

# Blob backend: local (default) | s3.
#INQTRIX_OBJECT_STORE_BACKEND=s3

# Root directory of the local backend (created on first write).
#INQTRIX_OBJECT_STORE_PATH=data/object-store

# S3-compatible endpoint; required when the backend is s3.
#INQTRIX_S3_ENDPOINT_URL=http://127.0.0.1:8333
#INQTRIX_S3_BUCKET=inqtrix-files
#INQTRIX_S3_ACCESS_KEY=inqtrix-dev-access
#INQTRIX_S3_SECRET_KEY=inqtrix-dev-secret

# Upload size limit in bytes (default 100 MiB -> HTTP 413 above).
#INQTRIX_MAX_FILE_BYTES=104857600

# Server-side preparation of uploads, independent of knowledge:
# markitdown (default — pure Python, no ML models, handles
# PDF/DOCX/PPTX/XLSX/HTML) | none (uploads keep only their original).
# Chat attachments and knowledge ingestion read the prepared text; switching
# it on later prepares earlier uploads from their stored originals.
#INQTRIX_DOCUMENT_PARSER=markitdown

# Public base URL of this server. When set, knowledge citations become
# clickable links into /v1/sources/...; empty keeps internal URIs.
#INQTRIX_PUBLIC_BASE_URL=https://inqtrix.example.com


# ============================================================
# 11. Hybrid retrieval (Qdrant) + reranking, optional
# ============================================================
#
# Master switch for the knowledge engine. Off by default: no knowledge/sources
# routes, no embedding provider, mode=knowledge is not a registered algorithm.
#INQTRIX_KNOWLEDGE_ENABLED=true

# Vector backend for the knowledge engine: memory (default) | qdrant.
# qdrant requires the knowledge-qdrant extra and the dev compose stack
# (or any Qdrant instance). One physical collection per embedding
# model; logical collections are payload-partitioned.
#INQTRIX_VECTOR_BACKEND=qdrant
#INQTRIX_QDRANT_URL=http://127.0.0.1:6333
#INQTRIX_QDRANT_API_KEY=inqtrix-dev-qdrant-key

# Lexical branch (BM25, German stemming) fused with dense via RRF.
# The Qdrant server computes the sparse vectors itself (core BM25
# inference, server >= 1.15.3 — checked at startup); nothing is
# downloaded at runtime. Eval-backed guidance: pair hybrid with a
# reranker; without one, dense-only ("off") has better top-1
# precision on paraphrases.
#INQTRIX_KNOWLEDGE_SPARSE=bm25_german

# Embedding auth scheme: openai_compatible (default) | azure.
# azure uses deployment-based auth and falls back to the established
# AZURE_AI_PROJECT_ENDPOINT / AZURE_AI_PROJECT_API_KEY /
# AZURE_OPENAI_API_KEY variables — one extra line enables it.
#INQTRIX_EMBEDDING_PROVIDER=azure

# Optional cross-encoder rerank stage (Cohere schema — native or
# Azure AI Foundry serverless deployment).
#INQTRIX_RERANKER_PROVIDER=cohere
#INQTRIX_RERANKER_BASE_URL=https://<deployment>.<region>.models.ai.azure.com
#INQTRIX_RERANKER_API_KEY=
#INQTRIX_RERANKER_MODEL=cohere-rerank-v4.0-pro

# Contextual retrieval: durable ingestion groups contiguous chunks into
# model-budgeted fast-tier calls (at most 25 chunks per call, further bounded
# by the JSON output contract). Up to three batches run concurrently, capped
# by the provider's declared LLM concurrency. Validated batches checkpoint;
# failures stop new dispatch without discarding other completed batches, and
# a raw build requires an explicit user choice.
# The committed EU-AI-Act hard-set baseline records recall@1 0.9375 ->
# 0.9688 on top of hybrid+rerank. Cost is ceil(chunks / effective batch
# size) calls — point TIER_FAST_MODEL at a mini model. Off by default;
# rebuild to apply.
#INQTRIX_KNOWLEDGE_CONTEXTUALIZE=on
# Shared provider/model circuit: dependency failures pause visibly and stop
# further calls until one leased recovery probe is admitted after cooldown.
# These are protection/recovery windows, not indexing timeouts.
#INQTRIX_CONTEXTUALIZATION_CIRCUIT_COOLDOWN_SECONDS=60
#INQTRIX_CONTEXTUALIZATION_CIRCUIT_PROBE_LEASE_SECONDS=900

# Durable aggregate deletion workers and technical receipt retention.
# Terminal receipts contain identifiers/status only, never document bodies.
#INQTRIX_DELETION_MAX_CONCURRENT=2
#INQTRIX_DELETION_RECEIPT_RETENTION_SECONDS=2592000

# --- Sharing ----------------------------------------------------------------
# Confine resource sharing to workspace boundaries. When true, a user may only
# share with people they share at least one workspace with, and the share
# typeahead is scoped the same way. Default false keeps sharing tenant-wide
# (byte-identical). Only meaningful in the cookie-session modes (oidc/local).
INQTRIX_SHARING_RESTRICT_TO_WORKSPACE_MEMBERS=false
