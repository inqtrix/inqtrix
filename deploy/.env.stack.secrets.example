# Inqtrix Stack credentials.
#
# Copy to deploy/.env.stack.secrets, replace every active CHANGE_ME value, and
# restrict the file before starting the stack:
#
#   chmod 0600 deploy/.env.stack.secrets
#
# For a named environment, keep the environment suffix last, for example:
#
#   deploy/.env.stack.azure
#   deploy/.env.stack.secrets.azure
#
# Always load this file BEFORE deploy/.env.stack. The config file's visible DSN
# expression then resolves this secret without duplicating it. Never commit the
# populated copy and never pass credentials directly as command-line arguments.

# Bundled PostgreSQL. The password must use the URL-safe alphabet
# A-Z, a-z, 0-9, dot, underscore, tilde, and hyphen because it is interpolated
# verbatim into the runtime DSN.
INQTRIX_PG_PASSWORD=CHANGE_ME_PG_PASSWORD
# When using external PostgreSQL, comment out or remove this bundled-only
# placeholder; otherwise the preflight correctly refuses the unresolved
# CHANGE_ME value even though no bundled postgres service is started.

# External PostgreSQL only. This is a Compose interpolation value, not an
# Inqtrix application setting by itself. When the visible INQTRIX_DATABASE_URL
# references ${INQTRIX_EXTERNAL_DATABASE_PASSWORD}, uncomment it here. Use a
# URL-safe value or percent-encode reserved URL characters before placing it
# inside the visible DSN:
# INQTRIX_EXTERNAL_DATABASE_PASSWORD=CHANGE_ME_EXTERNAL_RUNTIME_PASSWORD

# Cookie sessions and personal access tokens. Use independent random values;
# rotating the session secret logs every browser session out.
INQTRIX_SESSION_SECRET=CHANGE_ME_SESSION_SECRET
INQTRIX_PAT_PEPPER=CHANGE_ME_PAT_PEPPER
# Stable subject pseudonyms in logs/traces/audit correlation: the API server
# and every worker MUST share this value, otherwise the same person shows up
# under different usr_<hex> references per process. Empty falls back to
# per-process references (startup WARNING). Rotation deliberately unlinks all
# previously written pseudonyms. Required for INQTRIX_AUTH_MODE=oidc.
INQTRIX_PSEUDONYM_PEPPER=CHANGE_ME_PSEUDONYM_PEPPER

# Provider credentials: uncomment and fill only the selected LLM and search
# providers. The visible config defaults to LiteLLM + Perplexity, but leaving
# placeholder credentials active would make every alternative-provider
# preflight fail even though those values are intentionally unused.
# LITELLM_API_KEY=CHANGE_ME_LITELLM_KEY
# PERPLEXITY_API_KEY=CHANGE_ME_PERPLEXITY_KEY
# ANTHROPIC_API_KEY=CHANGE_ME
# AZURE_OPENAI_API_KEY=CHANGE_ME
# AZURE_CLIENT_SECRET=CHANGE_ME
# AZURE_AI_PROJECT_API_KEY=CHANGE_ME

# Optional auth modes.
# INQTRIX_SERVER_API_KEY=CHANGE_ME_BEARER_TOKEN
# INQTRIX_OIDC_CLIENT_SECRET=CHANGE_ME_OIDC_SECRET

# Knowledge and retrieval credentials. INQTRIX_QDRANT_API_KEY is required when
# --profile knowledge starts the bundled Qdrant service; the remaining values
# are optional unless their corresponding provider is selected.
# INQTRIX_QDRANT_API_KEY=CHANGE_ME_QDRANT_KEY
# INQTRIX_EMBEDDING_API_KEY=CHANGE_ME_EMBEDDING_KEY
# INQTRIX_EMBEDDING_AZURE_API_KEY=CHANGE_ME_EMBEDDING_AZURE_KEY
# INQTRIX_RERANKER_API_KEY=CHANGE_ME_RERANKER_KEY

# Optional workers profile.
# INQTRIX_VALKEY_PASSWORD=CHANGE_ME_VALKEY_PASSWORD

# Optional collaboration and account-less guest links. These must be
# independent from each other and from INQTRIX_SESSION_SECRET.
# INQTRIX_COLLABORATION_SECRET=CHANGE_ME_MIN_32_CHARS_INDEPENDENT_SECRET
# INQTRIX_EDITOR_GUEST_LINK_TOKEN_SECRET=CHANGE_ME_ANOTHER_32_CHAR_INDEPENDENT_SECRET

# Optional observability profile (self-hosted Langfuse trace backend).
# All independent random values (`openssl rand -hex 32`), except:
# ENCRYPTION_KEY must be EXACTLY 64 hex chars, and the two INIT keys are
# the OTLP project credentials Langfuse creates at first start. Keep the
# pk-lf-/sk-lf- prefixes.
# LANGFUSE_CLICKHOUSE_PASSWORD=CHANGE_ME_CLICKHOUSE_PASSWORD
# LANGFUSE_VALKEY_PASSWORD=CHANGE_ME_LANGFUSE_VALKEY_PASSWORD
# LANGFUSE_SALT=CHANGE_ME_LANGFUSE_SALT
# LANGFUSE_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS
# LANGFUSE_NEXTAUTH_SECRET=CHANGE_ME_LANGFUSE_NEXTAUTH_SECRET
# LANGFUSE_INIT_USER_PASSWORD=CHANGE_ME_LANGFUSE_ADMIN_PASSWORD
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-CHANGE_ME
# LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-CHANGE_ME
#
# With INQTRIX_TRACING=otlp the SAME key pair authenticates the OTLP
# export. The headers variable lives HERE (not in the visible config
# template) because its value embeds the secret key. Build the base64
# part with:  printf '%s' 'pk-lf-…:sk-lf-…' | base64
# The trailing x-langfuse-ingestion-version=4 pair is required for
# real-time display in Langfuse.
# Reference: docs/configuration/settings-and-env.md.
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic CHANGE_ME_BASE64_PK_SK,x-langfuse-ingestion-version=4

# Optional password for an encrypted direct-TLS private key. Leave unset for
# an unencrypted key; compose.web-tls.yaml passes it only to the Python gateway.
# RESEARCH_DESK_SSL_KEYFILE_PASSWORD=CHANGE_ME_TLS_KEY_PASSWORD

# Optional bundled SeaweedFS or static S3-compatible credentials.
# INQTRIX_S3_ACCESS_KEY=CHANGE_ME_S3_ACCESS_KEY
# INQTRIX_S3_SECRET_KEY=CHANGE_ME_S3_SECRET_KEY
# INQTRIX_S3_SESSION_TOKEN=CHANGE_ME_OPTIONAL_STS_TOKEN

# Optional native AWS credential chain. Prefer workload identity or an
# instance/container role over long-lived values here.
# AWS_ACCESS_KEY_ID=CHANGE_ME_AWS_ACCESS_KEY
# AWS_SECRET_ACCESS_KEY=CHANGE_ME_AWS_SECRET_KEY
# AWS_SESSION_TOKEN=CHANGE_ME_OPTIONAL_AWS_SESSION_TOKEN
