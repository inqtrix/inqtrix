# Optional migration-only credential for managed/external PostgreSQL.
# Copy to a named file such as deploy/.env.migrate.secrets.azure, chmod 0600,
# and pass it explicitly:
#
#   inqtrix-deploy --external-db \
#     --migration-env-file deploy/.env.migrate.secrets.azure up --detach
#
# The selected deploy/.env.stack.<name> config must point
# `INQTRIX_MIGRATION_ENV_FILE` at the matching root-relative path, for example
# `deploy/.env.migrate.secrets.azure`.
#
# API and worker never load this file. They retain the restricted
# INQTRIX_DATABASE_URL from the selected deploy/.env.stack.<name> pair.

# Use a direct PostgreSQL connection, never PgBouncer transaction pooling.
# The dedicated login must satisfy the selected migration RLS mode documented
# in docs/deployment/database-migrations.md.
INQTRIX_MIGRATION_DATABASE_URL=postgresql+asyncpg://migration_user:CHANGE_ME@postgres.example.com:5432/inqtrix
