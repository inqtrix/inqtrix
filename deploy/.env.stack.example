# ============================================================================
# Inqtrix Stack mode:
#   1. Copy this file to deploy/.env.stack.
#   2. Copy deploy/.env.stack.secrets.example to
#      deploy/.env.stack.secrets, edit it, and chmod 0600 that file.
#   3. Run `inqtrix-deploy up --detach --build`.
#
# Low-level Compose usage must pass the same ordered pair:
#   docker compose -f deploy/compose/compose.stack.yaml \
#     --env-file deploy/.env.stack.secrets \
#     --env-file deploy/.env.stack up -d --build
#
# Two INDEPENDENT provider axes: pick ONE LLM block + ONE search block.
# Never commit either filled-in file; both are gitignored.
#
# Single source of truth for every variable (alias, default, allowed values):
# docs/configuration/settings-and-env.md. This file is a curated stack template.
# ============================================================================

# These root-relative pointers make raw Compose and service ``env_file`` use
# the same pair. Replace both values in every named copy. For an Azure-named
# pair, the two target paths are `deploy/.env.stack.azure` and
# `deploy/.env.stack.secrets.azure`.
INQTRIX_ENV_FILE=deploy/.env.stack
INQTRIX_SECRETS_FILE=deploy/.env.stack.secrets

# --- Bundled PostgreSQL identity and visible runtime target ---
INQTRIX_PG_USER=inqtrix
INQTRIX_PG_DB=inqtrix
# The password is defined only in deploy/.env.stack.secrets, which raw Compose
# and service env_file load first. Keeping the DSN expression here makes the
# effective topology inspectable without duplicating the secret.
INQTRIX_DATABASE_URL=postgresql+asyncpg://${INQTRIX_PG_USER:-inqtrix}:${INQTRIX_PG_PASSWORD}@postgres:5432/${INQTRIX_PG_DB:-inqtrix}
# API and worker use this runtime DSN. The one-shot migrate job takes
# INQTRIX_MIGRATION_DATABASE_URL from the separate migration env file and falls
# back to this URL only for bundled mode.
#
# --- External PostgreSQL (managed/enterprise) instead of the bundled one ---
# Any PostgreSQL 15+ works, including pgvector-enabled images (e.g.
# pgvector 0.5.1 on Postgres 15): Inqtrix uses PostgreSQL relationally only,
# the vector extension simply stays unused (vectors live in Qdrant).
# Four steps (details: docs/deployment/database-migrations.md):
#   1. Replace INQTRIX_DATABASE_URL above with the external DSN expression of
#      a DEDICATED UNPRIVILEGED runtime login. Replace the password expansion
#      with ${INQTRIX_EXTERNAL_DATABASE_PASSWORD}, then define that interpolation
#      value only in the companion secrets file. It is not assembled by a
#      helper script; the complete DSN remains visible here.
#   2. Set INQTRIX_DATABASE_RUNTIME_LOGIN_POLICY=restricted below.
#   3. Copy deploy/.env.migrate.secrets.example to a named private file such
#      as deploy/.env.migrate.secrets.azure, set the privileged
#      INQTRIX_MIGRATION_DATABASE_URL, and pass that file explicitly; pick
#      INQTRIX_MIGRATION_RLS_MODE
#      `bypass` (BYPASSRLS login) or `owner` (managed PG without BYPASSRLS).
#   4. Start with `inqtrix-deploy --external-db --migration-env-file
#      deploy/.env.migrate.secrets.azure up --detach --build` so the bundled
#      database container stays off.
# Required for external DB: every named config declares its migration file
# from the repository root. The CLI verifies that this matches
# --migration-env-file, and raw Compose resolves the same pointer through
# compose.external-db.yaml:
# INQTRIX_MIGRATION_ENV_FILE=deploy/.env.migrate.secrets.azure
#
# Which PostgreSQL LOGIN the api/worker use underneath the transaction-scoped
# application role (SET LOCAL ROLE inqtrix_app). Options:
#   restricted     = production default for managed/external PostgreSQL: the
#                    runtime DSN must be a DEDICATED least-privilege login (no
#                    SUPERUSER/BYPASSRLS/schema ownership); verified at
#                    startup, a privileged login is refused loudly.
#   bundled_legacy = compatibility boundary ONLY for the bundled Postgres of
#                    THIS compose stack (the historical single login that also
#                    owns the schema). Never use it with an external database.
# Role model + setup SQL: docs/deployment/database-migrations.md.
INQTRIX_DATABASE_RUNTIME_LOGIN_POLICY=bundled_legacy
# Migrations are an automatic one-shot dependency for fresh installs and
# already-at-head restarts. Every actual revision change on an installed schema
# requires the maintenance sequence documented in database-migrations.md:
# stop ingress and all database clients/poolers, drain sessions, set
# set the migration quiescence assertion for the one-shot job, verify head,
# then recreate workloads. Bundled Postgres uses `auto`; managed Postgres uses
# a dedicated migration login and explicit `bypass` or `owner` authority. The
# optional guarded `owner-upgrade` command automates the owner-mode sequence.
INQTRIX_MIGRATION_RLS_MODE=auto
# INQTRIX_MIGRATION_SERVICES_QUIESCED=false
# The wrapper passes the migration path separately. Leaving it unset makes the
# job fall back to the runtime DSN for the bundled database only.

# --- Persistence and object storage ---
# Where runs, identity, knowledge metadata and prompt templates live:
# postgres (durable; the stack default) or memory (in-process, lost on restart).
INQTRIX_STORAGE_BACKEND=postgres
# Where uploaded file blobs live: local volume (default) or s3. Only the
# bundled SeaweedFS option needs `--profile s3`; managed S3 does not.
# In THIS compose stack api + worker share one named volume on one host, so
# `local` is safe here. Once you run replicas on SEPARATE hosts (k8s, swarm),
# declare it via INQTRIX_REPLICA_COUNT=<n> — the app then refuses `local`
# loudly at startup (per-replica disk would 404 blobs across replicas); use s3.
INQTRIX_OBJECT_STORE_BACKEND=local
# To use any S3 topology, REPLACE `local` above with `s3`; do not append a
# second assignment. Configure this single adjacent S3 block as needed. The
# values shown are the bundled SeaweedFS defaults:
# INQTRIX_S3_AUTH_MODE=static
# INQTRIX_S3_ENDPOINT_URL=http://seaweedfs:8333
# INQTRIX_S3_BUCKET=inqtrix-files
# For local SeaweedFS this is only the S3 Signature-V4 compatibility scope,
# not a physical storage location. `us-east-1` is the built-in default.
# INQTRIX_S3_REGION=us-east-1
# INQTRIX_S3_ADDRESSING_STYLE=path
# INQTRIX_S3_BUCKET_PROVISIONING=create_if_missing
#
# Option A — bundled SeaweedFS: use the values above, set a dedicated access
# key pair in deploy/.env.stack.secrets, and add `--profile s3`. The profile
# starts SeaweedFS; INQTRIX_OBJECT_STORE_BACKEND=s3 selects it in the app.
# SeaweedFS otherwise permits anonymous access, so Compose refuses to start
# when either credential is empty.
#
# Option B — native AWS S3: do NOT use `--profile s3`. Use auth mode `default`,
# an empty endpoint, your bucket and region, addressing style `auto`, and
# provisioning `existing`. Prefer workload/container/instance identity.
#
# Option C — MinIO, R2, Ceph, NooBaa, Nutanix Objects, or another compatible
# provider: do NOT use `--profile s3`. Use auth mode `static`, the provider
# endpoint, bucket and region, its required addressing style, and provisioning
# `existing`. Put static or temporary credentials only in the secrets file.
#
# Optional private-CA mount for Options B/C. A configured host path must exist:
# INQTRIX_S3_CA_BUNDLE_HOST=/absolute/host/path/private-object-store-ca.pem
# INQTRIX_S3_CA_BUNDLE=/etc/inqtrix/object-store/ca.pem
# Optional server-side encryption for Options B/C:
# INQTRIX_S3_SERVER_SIDE_ENCRYPTION=AES256   # none | AES256 | aws:kms
# INQTRIX_S3_KMS_KEY_ID=arn:aws:kms:REGION:ACCOUNT:key/KEY_ID
# Set INQTRIX_S3_ACCESS_KEY, INQTRIX_S3_SECRET_KEY, and an optional
# INQTRIX_S3_SESSION_TOKEN in deploy/.env.stack.secrets.
# Full provider recipes: docs/deployment/object-storage.md.
#
# INQTRIX_REPLICA_COUNT=1
# Connection budget of the POOLED engines. Every process counts the pooled
# engines it actually builds and logs the worst case at startup, so the number
# never has to be reconstructed from a list here. Worst case per process =
# pooled_engines x (POOL_SIZE + MAX_OVERFLOW), plus the agent checkpointer's
# own pool where the workspace agent runs. Keep the sum over all replicas below
# Postgres max_connections, raise that ceiling on the BUNDLED server with
# INQTRIX_BUNDLED_POSTGRES_MAX_CONNECTIONS, or front the database with a
# transaction pooler (--profile pgbouncer); a process whose own budget exceeds
# the server limit says so at startup. Defaults match SQLAlchemy (5 + 10).
# INQTRIX_DATABASE_POOL_SIZE=5
# INQTRIX_DATABASE_POOL_MAX_OVERFLOW=10
# INQTRIX_DATABASE_POOL_TIMEOUT_SECONDS=30
# Ceiling of the BUNDLED server itself (Compose-only interpolation; on
# Kubernetes use the Helm value postgres.maxConnections instead -- this
# name is read by nothing there). The image default of 100 does not
# cover the shipped run cap, so the stack sets 300; that figure carries
# headroom for the sum above and is an engineering estimate, not one measured
# at the run cap. Every connection costs memory, so raise the
# postgres service's memory alongside. An external database ignores this --
# that ceiling belongs to whoever runs it.
# INQTRIX_BUNDLED_POSTGRES_MAX_CONNECTIONS=300
# Per-STATEMENT wall-clock ceiling on pooled engines (0 disables): bounds the
# one hang pre-ping cannot catch — an in-flight statement on a dead connection.
# INQTRIX_DATABASE_COMMAND_TIMEOUT_SECONDS=120
#
# Optional transaction-mode PgBouncer in front of Postgres (absorbs the fan-in
# of many replicas/engines). Start the stack with `--profile pgbouncer` AND
# replace the visible INQTRIX_DATABASE_URL above with the pgbouncer:6432 target.
# The complete replacement value is
# `postgresql+asyncpg://${INQTRIX_PG_USER:-inqtrix}:${INQTRIX_PG_PASSWORD}@pgbouncer:6432/${INQTRIX_PG_DB:-inqtrix}?prepared_statement_cache_size=0`.
# (the ?prepared_statement_cache_size=0 suffix is required for asyncpg under
# transaction pooling). Alembic DDL never runs through the pooler: the migrate
# service constructs a direct postgres:5432 fallback from this same pair.
# Do not add a migration-only file for bundled PgBouncer.

# --- Workspace agent (Agent Desk) ---
# On the postgres backend above the workspace agent registers automatically
# (INQTRIX_AGENT_ENABLED defaults true) and the Agent Desk appears in the web
# UI — no extra variable needed. The stack image already bundles the `agent`
# extra (LangGraph postgres checkpointer). Do NOT set INQTRIX_AGENT_ALLOW_VOLATILE
# here: that is a dev-only escape yielding a non-durable agent that loses parked
# approvals on restart. Recommended for the agent's msgpack checkpoints:
LANGGRAPH_STRICT_MSGPACK=true
#
# Optional server-side default tier for agent runs: schnell | gruendlich | tief
# (speed vs depth; the active budgets are published under agent.tiers in
# /v1/capabilities). Empty keeps the legacy DEPTH semantics for requests that
# send no tier; users can still pick a tier per request in the UI.
# AGENT_TIER=gruendlich
# Reference count above which the synthesis PROMPT digest is capped to the
# top-ranked references. The citation ledger is never truncated; 0 disables
# the cap. Default 160.
# INQTRIX_AGENT_SYNTHESIS_EVIDENCE_BUDGET=160
# The kernel engine path (mode=agent_kernel) is the default. It is additionally
# gated at startup (durable checkpointer, deepagents availability, native tool
# calling on the default LLM); a failed gate logs a WARNING, the mode stays
# unavailable and capabilities name the gate under feature_status.agent_kernel.
# Uncomment to run the phase machine (workspace_agent) instead.
# INQTRIX_AGENT_KERNEL_ENABLED=false

# --- Auth --- (see docs/deployment/auth-modes.md for the full picture)
# Modes: local | oidc | apikey | none.
#   local  = native email/password with first-run owner setup (the
#            default). Needs INQTRIX_SESSION_SECRET + INQTRIX_PAT_PEPPER in the
#            companion secrets file and the postgres backend. Also set
#            INQTRIX_PSEUDONYM_PEPPER there (same value for api and worker):
#            it keeps the pseudonymous usr_<hex> subject references in logs
#            stable across processes and restarts, so one person stays ONE
#            reference; without it correlation degrades to per-process
#            references (startup WARNING; required for oidc). On the first
#            start the web app shows an owner-setup screen; that account becomes
#            the instance admin and manages further users under
#            Settings -> Administration -> Users.
#   oidc   = browser SSO via your IdP (block below).
#   apikey = one shared Bearer token (set INQTRIX_SERVER_API_KEY).
#   none   = single-user, no login (no scoped identity, so no sharing).
INQTRIX_AUTH_MODE=local
# Account-creation policy for local mode: closed (default = owner + admin-
# created accounts only) or open (public self-signup, logged loudly).
INQTRIX_LOCAL_REGISTRATION=closed
# How long a browser login stays valid, in seconds, for the cookie-session
# modes local/oidc. The limit is ABSOLUTE (counted from login; activity
# does not extend it): on expiry the API returns 401 and the web app shows the
# login screen again. Default 28800 (8 hours). Raise it for stay-logged-in
# convenience on trusted machines (e.g. 604800 = 7 days); the session cookie
# itself only lives until the browser fully closes, so surviving a reboot also
# needs the browser's own session restore ("continue where you left off").
# INQTRIX_SESSION_MAX_AGE_SECONDS=28800
# Plain-HTTP localhost caveat: browsers reject Secure/__Host- cookies on
# http://localhost, which breaks the session cookie for local/oidc.
# Only for http loopback dev (NEVER in production):
# INQTRIX_OIDC_INSECURE_DEV_COOKIES=true
#
# For apikey mode, set INQTRIX_AUTH_MODE=apikey here and the bearer token in
# deploy/.env.stack.secrets.
#
#
# Enterprise SSO. Change the single INQTRIX_AUTH_MODE assignment above from
# `local` to `oidc`, then point Inqtrix at YOUR OIDC provider (Okta, Entra ID,
# Keycloak, ...) reachable from both the browser and the api container.
# The single INQTRIX_PUBLIC_BASE_URL field in Web ingress derives the callback
# URL, so it MUST match how the browser reaches the app. Register
# https://<your-host>/api/auth/callback at the IdP. The bundled `--profile oidc`
# Dex is a DEV reference only (see docs/deployment/auth-modes.md).
# INQTRIX_OIDC_ISSUER=https://your-idp.example/
# INQTRIX_OIDC_CLIENT_ID=inqtrix
# Set INQTRIX_OIDC_CLIENT_SECRET in deploy/.env.stack.secrets.

# --- Web ingress ---
# Host port for the single selected web adapter: Python by default, or nginx
# with compose.web-nginx.yaml. Open http://localhost:<port>. Bound to loopback
# by default; put a TLS reverse proxy in front for remote access.
INQTRIX_WEB_PORT=8080
# Keep loopback for a workstation. Set 0.0.0.0 only for a trusted LAN test or
# behind a properly hardened TLS ingress; this exposes the web port on every
# host interface.
# INQTRIX_WEB_BIND_ADDRESS=127.0.0.1
# Exact public browser origin for OIDC, trusted forwarded headers, guest links,
# or direct TLS. Leave unset for ordinary local-mode loopback HTTP.
# INQTRIX_PUBLIC_BASE_URL=https://desk.example:8080
# The API enforces INQTRIX_MAX_FILE_BYTES per file (plain bytes, default
# 104857600 = 100 MiB). The Python web gateway derives its whole-request cap as
# this value + 10 MiB so the API's labelled 413 remains authoritative. Override
# the derived cap only with INQTRIX_PROXY_MAX_BODY_BYTES (also plain bytes):
# INQTRIX_MAX_FILE_BYTES=524288000
# INQTRIX_PROXY_MAX_BODY_BYTES=534773760
#
# Direct TLS for Compose/Bare Metal uses the SAME web image with the optional
# deploy/compose/compose.web-tls.yaml override. Keep certificates outside this
# repository and use absolute host paths:
# INQTRIX_WEB_TLS_CERTFILE=/absolute/path/tls.crt
# INQTRIX_WEB_TLS_KEYFILE=/absolute/path/tls.key

# --- Logging / observability (all optional) ---
# The app always logs to stdout/stderr (in Docker: `docker compose ... logs -f api`).
# LOG_LEVEL and OBSERVABILITY_PROFILE shape THAT output and apply independently of
# the file flag below, so the content-minimized `forensic` projection also shows
# up in `docker compose logs` (exact queries/evidence/prompts/URLs do not):
# INQTRIX_LOG_LEVEL=INFO          # DEBUG | INFO | WARNING (verbosity on stdout)
# OBSERVABILITY_PROFILE=summary   # summary | forensic (protected audit + safe operational projection)
# INQTRIX_LOG_CONSOLE=true        # also mirror WARNING+ to stderr (handy in server mode)
#
# Log line SHAPE: `text` (default, human-readable pipe format) or `json` (one
# machine-readable object per line for Loki/SIEM/jq). Every json line carries
# the correlation fields request_id / run_id / user (stable pseudonym, see
# INQTRIX_PSEUDONYM_PEPPER) / workspace / tenant, so one person or one run can
# be followed across api and worker containers with a single grep. Secret
# redaction is identical in both shapes. Recommended for container stacks:
# INQTRIX_LOG_FORMAT=json
#
# Setting `INQTRIX_LOG_ENABLED=true` only ADDS a second sink: a file
# logs/inqtrix_<timestamp>.log
# (auto-created on first write). In a container that path is /app/logs, which is
# EPHEMERAL: the file is written but lost on container removal. This variable does NOT
# create a Docker volume, that is a separate edit in compose.stack.yaml, so in Docker
# just use `... logs`. On the host (library/webserver mode) the file lands in ./logs
# and is directly usable.
# INQTRIX_LOG_ENABLED=true
#
# Traces (agentic runs as OTel spans). WHERE spans go; OBSERVABILITY_PROFILE
# above stays the depth switch. Values:
#   off   = default, no tracer at all.
#   local = spans only stamp trace_id/span_id into json logs, no persistence.
#   file  = additionally spool spans as OTLP-JSON lines (size-capped via
#           INQTRIX_TRACE_SPOOL_MAX_MB, default 2048 MiB; replayable into
#           Langfuse later — record now, inspect on demand). In this stack
#           the spool lives on the shared trace_spool volume at
#           /var/lib/inqtrix/traces (api+worker write there, the admin
#           trace export reads it, recordings survive recreates); on a
#           plain host install it defaults to logs/traces/.
#   otlp  = live export to Langfuse/collector; set BOTH containers (api and
#           worker) and the two standard OTel variables:
#           OTEL_EXPORTER_OTLP_ENDPOINT=https://<langfuse>/api/public/otel
#           OTEL_EXPORTER_OTLP_HEADERS -> contains the project keys, so it
#           belongs in the SECRETS file (.env.stack.secrets*); the exact
#           format is documented there and in
#           docs/configuration/settings-and-env.md.
# Needs the `observability` extra (stack image includes it); missing extra
# logs a WARNING and stays off. Sampling: INQTRIX_TRACE_SAMPLE_RATE (1.0).
# Switching modes is safe at any time — traces are an ephemeral DEBUG
# stream; product data (runs, events, audit) always lives in Postgres
# regardless of this switch. Note when moving file -> otlp: previously
# spooled files are NOT imported automatically; run the replay CLI
# (python -m inqtrix.observability.replay) to load them into Langfuse.
# INQTRIX_TRACING=off
#
# Span CONTENT (prompts, redacted raw responses, search answers, kernel tool
# inputs and results) follows
# OBSERVABILITY_PROFILE by default: only the forensic profile captures it
# (auto). Override with on/off. Everything is redacted through the existing
# sanitizers and hard-capped per attribute; each cap raises a visible
# inqtrix.truncation span event.
# INQTRIX_TRACE_CONTENT=auto
# INQTRIX_TRACE_MAX_ATTR_BYTES=1048576
#
# Admin trace tooling (otlp mode). UI-URL: browser base URL of the Langfuse
# UI for the "open trace" deep link in the admin area — usually NOT the
# in-cluster OTLP host, e.g. http://localhost:3300 with the bundled profile;
# empty hides the link. Retention: the worker deletes traces older than this
# many days via the Langfuse API every 6 hours (native retention is EE-only;
# 0 turns the job off). The file spool is instead capped by size above.
# INQTRIX_TRACE_UI_URL=
# INQTRIX_TRACE_RETENTION_DAYS=30
# Export existing algorithm judgements as Langfuse scores (OTLP sink only).
# No additional model calls; failures warn without affecting product runs.
# INQTRIX_TRACE_SCORES=true
#
# Audit trail (always on — deliberately no off switch). The service-start
# toggle covers only the per-start index rows (runs/chat/indexing) the
# admin audit panel lists; retention prunes audit_log daily in the worker
# through the dedicated database function (0 = keep forever).
# INQTRIX_AUDIT_SERVICE_STARTS=true
# INQTRIX_AUDIT_RETENTION_DAYS=365
#
# Usage ledger (always on with the postgres backend): every LLM/search/
# embedding call books one llm_usage row (tokens, model, feature, user) --
# the consumption history a later usage UI reads. Quota stays the
# enforcement authority; costs derive at read time from model-card list
# prices and are never stored. Retention prunes daily in the worker
# (730 days = 24 months; 0 = keep forever).
# INQTRIX_USAGE_RETENTION_DAYS=730
#
# SELF-HOSTED LANGFUSE (--profile observability, requires --profile s3 or an
# external INQTRIX_S3_* object store): Langfuse v3 web+worker, ClickHouse and
# a dedicated Valkey join the stack; the bundled Postgres gets a separate
# `langfuse` database and SeaweedFS a separate bucket (both auto-created by
# one-shot init jobs). Set the LANGFUSE_* secrets in the companion secrets
# file, then point the api/worker at the backend by giving the two OTEL
# variables from the Traces block above these values:
#   endpoint  http://langfuse:3000/api/public/otel
#   headers   Authorization=Basic <base64 of pk-lf-…:sk-lf-…>,x-langfuse-ingestion-version=4
#   (compute: printf '%s:%s' "$PK" "$SK" | base64)
# The UI is published on localhost only (operator tool with its own login;
# first user comes from the headless-init secrets):
# INQTRIX_LANGFUSE_PORT=3300
# Set LANGFUSE_NEXTAUTH_URL when the UI is reached under a different URL
# than http://localhost:3300 (it must match what the browser uses):
# LANGFUSE_NEXTAUTH_URL=http://localhost:3300
# Naming overrides (defaults shown; ids are stable, do not rotate them):
# LANGFUSE_PG_DB=langfuse
# LANGFUSE_S3_BUCKET=langfuse
# LANGFUSE_INIT_ORG_ID=inqtrix
# LANGFUSE_INIT_ORG_NAME=Inqtrix
# LANGFUSE_INIT_PROJECT_ID=inqtrix
# LANGFUSE_INIT_PROJECT_NAME=Inqtrix
# LANGFUSE_INIT_USER_EMAIL=admin@example.com
# LANGFUSE_INIT_USER_NAME=Admin
#
# Prometheus /metrics endpoint (queue depth, active/capacity, admission
# rejections by reason, per-route request latency, plus the shared call
# metrics: LLM requests/duration/tokens, search, retrieval steps, run
# durations, queue wait, worker jobs, indexed documents). Off by default;
# needs the image built with the `metrics` extra (the stack image includes
# it). Labels carry no run-id/subject/session (bounded cardinality). When
# INQTRIX_SERVER_API_KEY is set, /metrics requires that Bearer token;
# otherwise it is unauthenticated -- keep it off your public ingress and
# scrape it only from inside the cluster / a NetworkPolicy allowlist.
# INQTRIX_METRICS_ENABLED=true
#
# Worker-process metrics: each worker can serve its OWN /metrics registry
# (LLM/search/retrieval calls made inside jobs, run durations, queue wait,
# worker job counters, indexed documents). 0 = off (default). Set a port >0
# AND INQTRIX_METRICS_ENABLED=true to serve http://worker:<port>/metrics --
# one scrape target per worker process, no pushgateway.
# INQTRIX_WORKER_METRICS_PORT=9091

# ============================================================================
# LLM PROVIDER: edit the single selector and configure exactly ONE provider
# ============================================================================
INQTRIX_LLM_PROVIDER=litellm
# -- litellm (OpenAI-compatible gateway) --
LITELLM_BASE_URL=http://litellm-proxy:4000/v1
# Set LITELLM_API_KEY in deploy/.env.stack.secrets.
# -- anthropic --  (set INQTRIX_LLM_PROVIDER=anthropic)
# Set ANTHROPIC_API_KEY in deploy/.env.stack.secrets.
# -- azure --      (set INQTRIX_LLM_PROVIDER=azure)
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# Set AZURE_OPENAI_API_KEY, or the service-principal secret, in the companion
# secrets file.
# AZURE_TENANT_ID=...
# AZURE_CLIENT_ID=...
# -- bedrock --    (set INQTRIX_LLM_PROVIDER=bedrock)
# AWS_PROFILE=your-profile                  # or the standard AWS chain
# AWS_REGION=eu-central-1

# --- Models (apply to whichever LLM provider is selected above) ---
# REASONING_MODEL is the fallback model for every agent role. Names are model
# ids, except for azure where they are DEPLOYMENT names.
REASONING_MODEL=gpt-4o
# Optional per-role tiers (each overrides REASONING_MODEL for its role):
#   high = answer synthesis   mid = plan + evaluate   fast = classify + claim extraction
# TIER_HIGH_MODEL=
# TIER_MID_MODEL=
# TIER_FAST_MODEL=
# Reasoning effort per tier: none | minimal | low | medium | high | xhigh.
# Empty inherits the provider default. anthropic/azure/bedrock honour this (e.g.
# turn on thinking for the high tier); the litellm gateway currently ignores it.
# TIER_HIGH_EFFORT=
# TIER_MID_EFFORT=
# TIER_FAST_EFFORT=
# Comma-separated model ids offered in the in-app model picker:
# INQTRIX_SELECTABLE_CHAT_MODELS=gpt-4o,gpt-4o-mini

# ============================================================================
# SEARCH PROVIDER: edit the single selector and configure exactly ONE provider
# ============================================================================
INQTRIX_SEARCH_PROVIDER=perplexity
# -- perplexity --  (SEARCH_MODEL is the web-search agent that runs the queries)
# Set PERPLEXITY_API_KEY in deploy/.env.stack.secrets.
SEARCH_MODEL=perplexity-sonar-pro-agent
# INQTRIX_SEARCH_PRESET=fast-search         # fast-search | pro-search | deep-research
# -- azure_foundry --  (set INQTRIX_SEARCH_PROVIDER=azure_foundry; reuses AZURE_* SP)
# AZURE_AI_PROJECT_ENDPOINT=https://your-project.services.ai.azure.com/api/projects/your-project
# WEB_SEARCH_AGENT_NAME=web-search-agent
# WEB_SEARCH_AGENT_VERSION=2                # optional; pin the agent version (unset = latest)
# Set AZURE_AI_PROJECT_API_KEY in the secrets file, or use the shared Azure SP.

# ============================================================================
# OPTIONAL CAPABILITIES (each block below is independent; enable only what you
# want). For each: add its --profile flag to the start command, edit an existing
# canonical selector when instructed, and uncomment only fields that do not
# already have an active assignment. Duplicate keys are always an error.
# ============================================================================

# ============================================================================
# OPTIONAL: KNOWLEDGE / RAG over your own documents  (--profile knowledge)
# ============================================================================
# Ingest documents and ask cited questions over them; document text + metadata
# live in Postgres (canonical), the vectors in Qdrant (persistent, hybrid
# retrieval), originals in the object store. Start with --profile knowledge AND
# uncomment the lines below. Independent of the workers section.
# The BM25 half of hybrid retrieval runs INSIDE the Qdrant server (core
# inference, no runtime downloads). The bundled Qdrant (1.19.0) always
# satisfies that; pointing INQTRIX_QDRANT_URL at an EXTERNAL Qdrant requires
# server >= 1.15.3, or the API/worker fail fast at startup with an error
# naming the remedy (upgrade the server or INQTRIX_KNOWLEDGE_SPARSE=off).
# INQTRIX_KNOWLEDGE_ENABLED=true
# INQTRIX_VECTOR_BACKEND=qdrant
# INQTRIX_QDRANT_URL=http://qdrant:6333
# Set INQTRIX_QDRANT_API_KEY in deploy/.env.stack.secrets.
#
# Embedding model for the document vectors (REQUIRED for knowledge; immutable per
# collection at creation, so changing it later only affects NEW collections). The
# id is whatever your embedding endpoint expects — for Azure that is the
# DEPLOYMENT NAME, not the public model id. Without this it defaults to
# text-embedding-3-small, which will fail on Azure if no such deployment exists.
# INQTRIX_EMBEDDING_MODEL=text-embedding-3-small
# Optional: ids offered in the collection-creation picker (empty = only the default):
# INQTRIX_SELECTABLE_EMBEDDING_MODELS=text-embedding-3-small,text-embedding-3-large
#
# How the embedding endpoint authenticates. Default openai_compatible reuses the
# LITELLM_* gateway (one proxy serves chat + embeddings). Set azure to call an
# Azure deployment directly; the azure_* fields fall back to AZURE_AI_PROJECT_* /
# AZURE_OPENAI_API_KEY.
# INQTRIX_EMBEDDING_PROVIDER=openai_compatible
# INQTRIX_EMBEDDING_BASE_URL=        # empty reuses LITELLM_BASE_URL
# Optional INQTRIX_EMBEDDING_API_KEY belongs in the secrets file.
# -- when INQTRIX_EMBEDDING_PROVIDER=azure --
# INQTRIX_EMBEDDING_AZURE_ENDPOINT=https://<resource>.openai.azure.com
# Replace the single INQTRIX_EMBEDDING_MODEL value above with the Azure
# deployment name; never add a second assignment.
# Optional INQTRIX_EMBEDDING_AZURE_API_KEY belongs in the secrets file.
# INQTRIX_EMBEDDING_AZURE_API_VERSION=2024-10-21
#
# Optional rerank stage after retrieval — raises top-1 precision markedly
# (hybrid WITHOUT a reranker loses recall@1 on paraphrase queries). none
# (default) skips it, visibly, via features.reranker in /v1/capabilities.
# cohere calls a Cohere-rerank-schema endpoint — native Cohere OR an Azure AI
# Foundry serverless deployment. llm ranks listwise through the deployment's own
# LLM (no extra infra, but ~10x slower/costlier and capped at 20 candidates).
# INQTRIX_RERANKER_PROVIDER=cohere
# INQTRIX_RERANKER_BASE_URL=https://<your-foundry-serverless>.<region>.models.ai.azure.com
# Optional INQTRIX_RERANKER_API_KEY belongs in the secrets file.
# INQTRIX_RERANKER_MODEL=cohere-rerank-v4.0-pro    # or rerank-v3.5 on native Cohere
# Candidate pool fetched before the reranker reduces it to top_k (recall vs cost):
# INQTRIX_RERANK_CANDIDATE_DEPTH=40
# Contextual retrieval (Anthropic-style): ingestion uses dynamic fast-tier
# batches (not one call per document) to create a short retrieval-only context
# per chunk. Off by default; rebuild existing documents to apply.
# INQTRIX_KNOWLEDGE_CONTEXTUALIZE=on
# A transient provider failure opens one tenant/provider/model circuit shared
# by every durable worker. Jobs pause visibly; no raw/partial fallback is
# published. After the cooldown, one leased half-open probe may run.
# INQTRIX_CONTEXTUALIZATION_CIRCUIT_COOLDOWN_SECONDS=60
# INQTRIX_CONTEXTUALIZATION_CIRCUIT_PROBE_LEASE_SECONDS=900

# ============================================================================
# OPTIONAL: SCALED / DURABLE RUN WORKERS  (--profile workers)
# ============================================================================
# By default research runs execute INSIDE the api process (in-memory queue).
# This moves them onto a Valkey queue processed by separate worker containers.
# Why use it:
#   - run many in parallel without blocking the api,
#   - in-flight runs SURVIVE an api restart or redeploy (the in-memory default
#     loses queued and running ones).
# When: many concurrent users, or long runs you must not lose. For a single user
# or light use, leave it off. INDEPENDENT of RAG: Qdrant does not need this, and
# this does not need Qdrant. Start with --profile workers AND uncomment below.
# INQTRIX_QUEUE_BACKEND=valkey
# This visible DSN stays in config; only INQTRIX_VALKEY_PASSWORD belongs in
# deploy/.env.stack.secrets.
# INQTRIX_VALKEY_URL=redis://:${INQTRIX_VALKEY_PASSWORD}@valkey:6379/0
#
# The queue speaks the Redis protocol, so the BUNDLED broker may run either
# engine (Redis 6.2 is the floor; nothing newer is used). ENGINE picks the
# server/CLI binaries, IMAGE the image -- change BOTH together, and note that
# they also apply to the separate langfuse broker of --profile observability.
# Only the valkey default is digest-pinned and updated by this project; any
# other image is yours to pin and to patch. Switching engines needs a FRESH
# volume (incompatible RDB/AOF files) -- drain running runs, then
# `podman volume rm inqtrix_valkey_data`.
#   valkey (default)  docker.io/valkey/valkey:9.1.0@sha256:...   BSD-3-Clause
#   redis             docker.io/library/redis:8-alpine@sha256:...  AGPLv3/RSALv2/SSPLv1
#   redis             docker.io/library/redis:7.2-alpine@sha256:... BSD-3-Clause, frozen
# Avoid the `redis:7-alpine` tag: it resolves to 7.4.x, the only line without an
# open-source option.
# INQTRIX_BROKER_ENGINE=redis
# INQTRIX_BROKER_IMAGE=docker.io/library/redis:8-alpine@sha256:CHANGE_ME_PIN_YOUR_OWN_DIGEST

# ============================================================================
# OPTIONAL: LIVE EDITOR COLLABORATION  (--profile collaboration)
# ============================================================================
# Real-time multi-user editing via a private Node/Hocuspocus sidecar. Needs
# the postgres backend and a cookie-session auth mode (local/oidc).
# Start with --profile collaboration AND uncomment BOTH lines below: the
# profile only starts the container, the flag turns the feature on — and the
# API refuses to start (loud ValidationError) when the flag is on without a
# valid secret. The secret must be INDEPENDENT (never reuse
# INQTRIX_SESSION_SECRET) and at least 32 characters, e.g.
# `openssl rand -hex 32`. Full recipe: docs/deployment/editor-collaboration.md
# INQTRIX_COLLABORATION_ENABLED=true
# Set INQTRIX_COLLABORATION_SECRET in deploy/.env.stack.secrets.

# Direct person-to-person sharing is independently switchable. Disabling it
# suspends stored grants without deleting them; re-enabling restores every
# non-revoked grant.
# INQTRIX_SHARING_ENABLED=true

# Account-less editor links are deliberately OFF by default. They additionally
# require sharing + collaboration, PostgreSQL, Valkey, an exact public HTTPS
# base URL, and a third independent secret. A plain HTTP/LAN stack refuses to
# start with this module enabled.
# INQTRIX_EDITOR_GUEST_LINKS_ENABLED=false
# INQTRIX_EDITOR_GUEST_LINK_STATS_ENABLED=true
# Set INQTRIX_EDITOR_GUEST_LINK_TOKEN_SECRET in the secrets file.
# INQTRIX_EDITOR_GUEST_LINK_DEFAULT_TTL_SECONDS=604800
# INQTRIX_EDITOR_GUEST_LINK_MAX_TTL_SECONDS=2592000

# ============================================================================
# OPTIONAL: CONCURRENCY & THROUGHPUT TUNING  (sensible defaults shown)
# ============================================================================
# How much runs in parallel. The research graph and document re-embedding are
# synchronous work on a bounded thread pool, NOT unbounded async: each active
# job holds one thread. So these caps are the real parallelism per process;
# extra jobs wait in a FIFO queue, and a full queue returns HTTP 429. The true
# ceiling is your LLM/embedding provider's rate limit and the host's CPU/RAM,
# not these numbers — raise them when the provider has headroom, lower them on
# provider 429s. To scale BEYOND one process, add the workers profile above
# (horizontal scaling) rather than pushing a single process very high.
#
# MAX_CONCURRENT: concurrent /v1/chat/completions AND native /v1/runs (unless
#   RUN_MAX_CONCURRENT overrides runs). Default 100 -- sized so a hundred
#   people work at once without queueing; a run mostly waits on its provider.
# MAX_CONCURRENT=100
# RUN_MAX_CONCURRENT: separate cap for native /v1/runs, default 100. Leaving
#   this line commented yields that default, NOT a fallback to MAX_CONCURRENT;
#   an empty value (RUN_MAX_CONCURRENT=) fails startup validation.
# RUN_MAX_CONCURRENT=100
# RUN_MAX_CONCURRENT_PER_USER: optional per-user fairness bound UNDER the global
#   run cap (unset = global-only, single-tenant deployments unchanged). Caps a
#   single subject's QUEUED+RUNNING native runs so one heavy user cannot fill
#   every slot and starve others; parked (waiting) agent runs are excluded, and
#   agent child runs count against the parent's user, so size it above one agent
#   tree (children + burst). The monthly quota still bounds each user's spend.
# RUN_MAX_CONCURRENT_PER_USER=4
# RUN_QUEUE_MAX_SIZE: native runs allowed to WAIT once all run slots are busy;
#   beyond this POST /v1/runs returns 429. Default 100, matching the run cap:
#   a full slate can be waited on once over before anyone is refused.
# RUN_QUEUE_MAX_SIZE=100
# INQTRIX_STREAM_READER_WORKERS (api process only): threads reserved for
#   event-stream readers,
#   kept apart from the AI thread lane so a busy chat cannot stall event
#   delivery. Drawn on by every open run stream, indexing stream and streamed
#   chat completion; viewer count is not bounded by run count. Sized above the
#   run cap so a full slate of runs with a viewer each still gets its own
#   reader. Past this many readers they are served in rotation -- events are
#   delayed, never dropped. Default 128.
# INQTRIX_STREAM_READER_WORKERS=128
#
# INQTRIX_REINDEX_MAX_CONCURRENT: how many collection-generation or immutable
#   document-revision operations may execute at the same time. A collection
#   generation is serialized; independently fenced document revisions may run
#   alongside it. Within a collection-generation job documents embed one-by-one.
#   Concurrent reindexes add up on the embedding endpoint and compete with live
#   query-embedding for search, so this is a background-throughput vs.
#   interactive-latency dial. Default 6; lower it if bulk reindex starves live
#   search or hits the embedding provider's rate limit.
# INQTRIX_REINDEX_MAX_CONCURRENT=6
# INQTRIX_REINDEX_QUEUE_MAX_SIZE: reindex jobs allowed to WAIT; full -> 429. Default 50.
# INQTRIX_REINDEX_QUEUE_MAX_SIZE=50
# INQTRIX_REINDEX_COMPLETED_TTL_SECONDS retains TERMINAL job history only.
#   Queued/running/cancelling and dependency/validation-paused operations have
#   no age deadline. Default 3600.
# INQTRIX_REINDEX_COMPLETED_TTL_SECONDS=3600
# INQTRIX_REINDEX_AUTO_RESUME_ATTEMPTS: automatic resumes of one job a provider,
#   vector-store or quota outage paused, in a row without progress. Waits grow
#   from 60 seconds to 15 minutes; progress starts a new count. A validation
#   pause, and a dependency pause past this bound, waits for an explicit
#   resume/cancel/raw choice. 0 leaves every pause to a person. Default 5.
# INQTRIX_REINDEX_AUTO_RESUME_ATTEMPTS=5
# INQTRIX_GENERATION_ROLLBACK_RETENTION_SECONDS controls how long the previous
# validated collection generation can be restored. Cleanup runs on the normal
# worker maintenance cadence and resumes visibly after partial failure.
# INQTRIX_GENERATION_ROLLBACK_RETENTION_SECONDS=604800
#
# INQTRIX_WORKER_CONCURRENCY (workers profile only): the process-wide execution
#   ceiling for ONE worker. It sizes the research loop directly; the indexing,
#   upload and deletion loops each run at the LOWER of this and their own
#   ceiling (INQTRIX_REINDEX_MAX_CONCURRENT, INQTRIX_UPLOAD_MAX_CONCURRENT,
#   INQTRIX_DELETION_MAX_CONCURRENT), and a ceiling that binds is named in the
#   worker's startup log. That split is why this can be high: a research run
#   spends its thread waiting on a provider, while an upload extracts text and
#   spends real CPU. MAX_CONCURRENT / REINDEX_MAX_CONCURRENT still govern
#   API-side admission. Scale out with more replicas. Default 100.
# INQTRIX_WORKER_CONCURRENCY=100
# INQTRIX_UPLOAD_MAX_CONCURRENT (workers profile only): uploads executed at
#   once in one worker process.
#   Unlike a run, an upload extracts text from the file and spends real CPU,
#   so it is capped independently of the worker-wide value. Default 6.
# INQTRIX_UPLOAD_MAX_CONCURRENT=6
#
# USER-DRIVEN AI EXECUTION CONTRACT. Every provider attempt and backoff shares
# one logical-operation deadline; infrastructure, health, auth, queue, and SSE
# liveness timeouts remain separate. These active Stack values are published by
# /v1/capabilities and logged by API and worker at startup.
MAX_TOTAL_SECONDS=3600
REASONING_TIMEOUT=600
EDITOR_ASSISTANT_TIMEOUT=600
SEARCH_TIMEOUT=600
CLAIM_EXTRACT_TIMEOUT=600

# Agent/Research parallelism and the optional full-stack per-run token quota.
# Token quota exhaustion is a visible hard stop at the next safe boundary; it
# never truncates an already produced answer or task result.
INQTRIX_AGENT_MAX_PARALLEL_CHILDREN=6
INQTRIX_AZURE_FOUNDRY_MAX_CONCURRENCY=6
INQTRIX_QUOTA_MAX_TOKENS_PER_RUN=900000

# Connections the agent checkpointer's own psycopg pool may hold per process
# (shared by all concurrent agent runs; counted in the startup connection
# budget and shown in the admin runtime panel).
INQTRIX_AGENT_CHECKPOINTER_POOL_SIZE=4

# ============================================================================
# OPTIONAL: PER-USER QUOTAS  (no profile; multi-user modes local/oidc)
# ============================================================================
# Cap per-user monthly usage. Off by default and never enforced in the
# single-operator none/apikey modes. Turn on the master switch, then set the
# limits you want. EVERY limit is 0 = unlimited, so enabling alone changes
# nothing until you set real numbers. Admins tune per-user overrides in the UI
# (Settings -> Administration -> Quotas) within the *_MAX ceilings below.
# INQTRIX_QUOTA_ENABLED=true
# Monthly research runs per user, and the hard ceiling no admin override exceeds.
# INQTRIX_QUOTA_RUNS_PER_MONTH=0              # 0 = unlimited; e.g. 200
# INQTRIX_QUOTA_RUNS_PER_MONTH_MAX=0          # 0 = no ceiling; e.g. 1000
# Monthly LLM tokens per user (runs + chat + editor combined). One research run is
# roughly 50k to 200k tokens, so size the monthly budget from your expected volume.
# INQTRIX_QUOTA_LLM_TOKENS_PER_MONTH=0        # 0 = unlimited; e.g. 20000000  (20M)
# INQTRIX_QUOTA_LLM_TOKENS_PER_MONTH_MAX=0    # 0 = no ceiling; e.g. 50000000  (50M)
# Monthly embedding tokens per user (consumed by document ingestion).
# INQTRIX_QUOTA_EMBEDDING_TOKENS_PER_MONTH=0      # 0 = unlimited; e.g. 2000000  (2M)
# INQTRIX_QUOTA_EMBEDDING_TOKENS_PER_MONTH_MAX=0  # 0 = no ceiling; e.g. 5000000  (5M)
# Object-store bytes a user may hold (a STOCK quota, freed on delete). Value in bytes.
# INQTRIX_QUOTA_STORED_BYTES=0                # 0 = unlimited; e.g. 1073741824  (1 GiB)
# INQTRIX_QUOTA_STORED_BYTES_MAX=0            # 0 = no ceiling; e.g. 5368709120  (5 GiB)
# The optional hard per-run token budget has one canonical assignment in the
# concurrency/throughput section above. Edit that value there; `0` disables it.
