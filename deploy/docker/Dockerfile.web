# Inqtrix web edge: one SPA build and two explicit runtime targets.
#
# Default:
#   podman build -f deploy/docker/Dockerfile.web -t inqtrix-web .
# Enterprise nginx edge:
#   podman build --target web-nginx -f deploy/docker/Dockerfile.web \
#     -t inqtrix-web-nginx .

# --- Shared SPA build, resolved exclusively through package-lock.json ---
FROM docker.io/library/node:22.23.1-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS ui-build
WORKDIR /repo
ENV NPM_CONFIG_UPDATE_NOTIFIER=false

# Every workspace manifest is copied because npm validates the root workspace
# graph during `npm ci`, even though this target builds only Research Desk.
COPY package.json package-lock.json ./
COPY apps/collaboration-server/package.json apps/collaboration-server/
COPY apps/research-desk/package.json apps/research-desk/
COPY packages/editor-schema/package.json packages/editor-schema/
RUN npm ci \
      --include-workspace-root \
      --workspace @inqtrix/research-desk \
      --workspace @inqtrix/editor-schema

COPY apps/research-desk ./apps/research-desk
COPY packages/editor-schema ./packages/editor-schema
# Version source for the SPA's __APP_VERSION__ Vite define (vite.config.ts).
COPY src/inqtrix/__init__.py src/inqtrix/__init__.py
RUN npm run ui:build

# --- Python gateway dependencies, resolved from the repository uv.lock ---
FROM ghcr.io/astral-sh/uv:0.9.30-python3.12-bookworm-slim@sha256:e5b65587bce7de595f299855d7385fe7fca39b8a74baa261ba1b7147afa78e58 AS gateway-build
WORKDIR /app
ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1
COPY pyproject.toml uv.lock ./
RUN uv sync \
      --frozen \
      --no-install-project \
      --only-group web-gateway

# --- Optional Enterprise edge: nginx, selected only by an explicit target ---
FROM docker.io/nginxinc/nginx-unprivileged:1.27-alpine@sha256:025de0b541bcc6cfbf508e4201aaa37b51d34daaf6d52e5e2753e29a8ddaa869 AS web-nginx
ENV INQTRIX_BACKEND_URL=http://api:5100 \
    INQTRIX_MAX_FILE_BYTES=104857600 \
    INQTRIX_PROXY_MAX_BODY_BYTES= \
    NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1 \
    NGINX_ENVSUBST_OUTPUT_DIR=/tmp/nginx-conf.d

COPY --from=ui-build /repo/apps/research-desk/dist /usr/share/nginx/html
COPY deploy/nginx/bootstrap.conf /etc/nginx/conf.d/default.conf
COPY deploy/nginx/proxy-common.conf /etc/nginx/inqtrix/proxy-common.conf
COPY deploy/nginx/static-headers.conf /etc/nginx/inqtrix/static-headers.conf
COPY deploy/nginx/inqtrix.conf.template /etc/nginx/templates/inqtrix.conf.template
COPY --chmod=755 deploy/nginx/10-inqtrix-env.envsh /docker-entrypoint.d/10-inqtrix-env.envsh

# The base image already runs unprivileged. Copied configuration and SPA
# assets are read-only/world-readable; all runtime writes stay on /tmp.

# The nginx variant is a second shippable target, so it carries the same
# metadata -- a label on only one of two runtime stages is a gap a scanner
# finds and a person does not.
#
# It also has to CLEAR three labels it inherits from the nginx base image.
# The inherited `revision` and `created` describe the nginx image, and
# `url` points at nginx's repository -- so a scanner
# reads someone else's commit hash as this project's. Blank is ambiguous;
# inherited-and-wrong is false, and a false revision sends a reader looking
# for a commit that does not exist here. The two that CAN be true are set
# instead of blanked.
LABEL org.opencontainers.image.title="Inqtrix Web (nginx)" \
      org.opencontainers.image.description="Inqtrix web interface served by nginx." \
      org.opencontainers.image.version="0.2.0" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/inqtrix/inqtrix" \
      org.opencontainers.image.documentation="https://github.com/inqtrix/inqtrix#readme" \
      org.opencontainers.image.url="https://github.com/inqtrix/inqtrix" \
      org.opencontainers.image.revision="" \
      org.opencontainers.image.created=""

EXPOSE 8080

# --- Default final target: packaged Python gateway ---
FROM docker.io/library/python:3.12.13-slim-bookworm@sha256:d50fb7611f86d04a3b0471b46d7557818d88983fc3136726336b2a4c657aa30b AS web-python
WORKDIR /app
ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONPATH=/app/src \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp \
    RESEARCH_DESK_HOST=0.0.0.0 \
    RESEARCH_DESK_PORT=8080 \
    INQTRIX_BACKEND_URL=http://api:5100 \
    INQTRIX_DIST_DIR=/app/apps/research-desk/dist

COPY --from=gateway-build /app/.venv /app/.venv
COPY --from=ui-build /repo/apps/research-desk/dist /app/apps/research-desk/dist
COPY src/inqtrix_web_gateway /app/src/inqtrix_web_gateway

RUN chgrp -R 0 /app \
    && chmod -R g=u /app
USER 1001:0

EXPOSE 8080
# OCI metadata. Static only, and on purpose: `revision` and `created` are
# build-time facts this repository cannot know (there is no publishing
# pipeline), and a label carrying an empty value is worse than an absent one
# -- a scanner reads it as "declared, and blank". The version and licence are
# NOT typed twice: tests/test_image_metadata.py pins them against pyproject
# and legal.py, because a derived artefact drifts the moment nothing checks it.
LABEL org.opencontainers.image.title="Inqtrix Web" \
      org.opencontainers.image.description="Inqtrix web interface and its gateway." \
      org.opencontainers.image.version="0.2.0" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/inqtrix/inqtrix" \
      org.opencontainers.image.documentation="https://github.com/inqtrix/inqtrix#readme"

CMD ["python", "-m", "inqtrix_web_gateway"]
