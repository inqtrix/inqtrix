# Inqtrix API image: the FastAPI server (python -m inqtrix).
# Also serves the migrate and worker services via a `command:` override
# (the inqtrix-migrate / inqtrix-worker console scripts are on PATH).
#
# Build context is the repository root:
#   docker build -f deploy/docker/Dockerfile.api -t inqtrix-api .

# --- Stage 1: resolve deps + install the project with uv ---
FROM ghcr.io/astral-sh/uv:0.9.30-python3.12-bookworm-slim@sha256:e5b65587bce7de595f299855d7385fe7fca39b8a74baa261ba1b7147afa78e58 AS build
WORKDIR /app
ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1

# Lockfile + manifest first for layer caching, then the source.
COPY pyproject.toml uv.lock ./
COPY README.md LICENSE NOTICE ./
COPY src ./src

# Install into /app/.venv against the frozen lock. The knowledge/queue/agent
# extras are baked in so the `knowledge`, `workers` and workspace-agent paths
# work without rebuilding the image; the default (memory/local) paths never
# import them. The `agent` extra ships the LangGraph postgres checkpointer, so
# a postgres-backed stack auto-registers the workspace agent —
# without it /v1/capabilities reports workspace_agent:false and the Agent Desk
# stays hidden even though the runtime is fully wired. The `metrics` extra
# (prometheus-client) is baked in so INQTRIX_METRICS_ENABLED works without a
# rebuild; it stays dormant until the flag is set.
RUN uv sync --frozen --no-dev --extra agent --extra knowledge-qdrant --extra queue-valkey --extra metrics --extra observability

# --- Stage 2: slim runtime ---
FROM docker.io/library/python:3.12.13-slim-bookworm@sha256:d50fb7611f86d04a3b0471b46d7557818d88983fc3136726336b2a4c657aa30b
WORKDIR /app
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    HOME=/app \
    XDG_CACHE_HOME=/app/.cache \
    INQTRIX_SERVER_HOST=0.0.0.0 \
    INQTRIX_SERVER_PORT=5100

# The editable project install points the venv at /app/src; keep the same
# path so the .pth resolves. Migrations ship inside the package
# (src/inqtrix/storage/migrations) so inqtrix-migrate finds them.
COPY --from=build /app/.venv /app/.venv
COPY --from=build /app/src /app/src

# There is no /etc/passwd entry for UID 1001, so its primary group is 0 -- and a
# hardened runtime may substitute a different non-root UID in group 0 rather than
# the image's USER. Such a UID owns no files, so every path the process writes is
# made group-0 owned and group-writable (chgrp 0 + chmod g=u): /app for HOME,
# logs and the image-default
# object store (data/object-store), the XDG cache directory
# (XDG_CACHE_HOME), and the /var/lib/inqtrix mount points -- object store and
# trace spool -- pre-created so a mounted volume/PVC inherits these writable
# perms for the random UID (a fresh Docker named volume copies the image dir's
# perms; a Kubernetes PVC needs the same group-0 ownership via fsGroup). A mount
# point that is NOT pre-created here arrives root-owned without group write, and
# the process cannot write into it. USER 1001 keeps the container non-root.
RUN mkdir -p /app/.cache /app/data /var/lib/inqtrix/objects \
        /var/lib/inqtrix/traces \
    && chgrp -R 0 /app /var/lib/inqtrix \
    && chmod -R g=u /app /var/lib/inqtrix
USER 1001

EXPOSE 5100
# CMD (not ENTRYPOINT) so the compose `command:` override REPLACES it cleanly:
# the api service runs this default, while migrate/worker override it with the
# inqtrix-migrate / inqtrix-worker console scripts. With an exec-form ENTRYPOINT
# the override would instead be appended as args (python -m inqtrix <arg>).
# OCI metadata. Static only, and on purpose: `revision` and `created` are
# build-time facts this repository cannot know (there is no publishing
# pipeline), and a label carrying an empty value is worse than an absent one
# -- a scanner reads it as "declared, and blank". The version and licence are
# NOT typed twice: tests/test_image_metadata.py pins them against pyproject
# and legal.py, because a derived artefact drifts the moment nothing checks it.
LABEL org.opencontainers.image.title="Inqtrix API" \
      org.opencontainers.image.description="Inqtrix API server; also runs the migrate and worker commands." \
      org.opencontainers.image.version="0.2.0" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/inqtrix/inqtrix" \
      org.opencontainers.image.documentation="https://github.com/inqtrix/inqtrix#readme"

CMD ["python", "-m", "inqtrix"]
